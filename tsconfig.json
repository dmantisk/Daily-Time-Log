{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2020",
		"noImplicitAny": true,
		"moduleResolution": "Bundler",
		"importHelpers": true,
		"isolatedModules": true,
		"strict": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"lib": ["DOM", "ES2020"]
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "**/*.test.ts"]
}
