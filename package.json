{
	"name": "daily-time-log",
	"version": "0.8.3",
	"description": "Visualize daily time tracking directly from daily notes with minimal metadata.",
	"main": "dist/main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node .github/scripts/release-guard.mjs && node esbuild.config.mjs production",
		"test": "vitest run",
		"lint": "eslint . --ext .ts,.tsx",
		"lint:fix": "eslint . --ext .ts,.tsx --fix",
		"version": "node update-version.mjs && git add manifest.json versions.json"
	},
	"type": "module",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"esbuild": "^0.28.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"happy-dom": "^21.0.3",
		"obsidian": "^1.7.2",
		"tslib": "^2.6.0",
		"typescript": "^5.4.0",
		"vitest": "^4.1.11"
	},
	"allowScripts": {
		"esbuild@0.28.1": true
	}
}
